{
  "name": "user-management",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run build:client && cross-env PORT=3000 DISABLE_HTTPS=true tsx server/src/index.ts",
    "build:client": "npm run build -w client",
    "build:server": "npm run build -w server",
    "build": "npm run build -w client && npm run build -w server",
    "lint": "npm run build -w client && npm run build -w server",
    "start": "cross-env PORT=3000 DISABLE_HTTPS=true node server/dist/index.js",
    "certs:generate": "bash scripts/generate-certs.sh",
    "db:migrate": "node scripts/db-migrate.js",
    "test:unit": "npm run test -w server",
    "test:unit:watch": "npm run test:watch -w server",
    "test:unit:coverage": "npm run test:coverage -w server",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:edge": "playwright test --project=edge",
    "test:e2e:headed": "cross-env PWSLOWMO=400 playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "cross-env": "^10.1.0",
    "pg": "^8.23.0",
    "tsx": "^4.16.2",
    "vite": "^8.3.1"
  }
}
