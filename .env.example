# Copy this file to .env (gitignored) and fill in real values from your
# Supabase project's dashboard. See README's "Connecting to Supabase"
# section for exactly where to find each one.

# Direct Postgres connection (Project Settings -> Database -> Connection
# string, URI format). Used only by `npm run db:migrate` to run DDL —
# PostgREST/supabase-js (what the app itself uses at runtime) can't create
# tables. Not needed to just run the app, only to change the schema.
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Project Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co
# The "Secret key" (service_role-equivalent) — NOT the Publishable/anon key.
# Full admin access, bypasses Row Level Security — server-only, must never
# reach the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Optional — which Postgres schema the app's Supabase client queries.
# Defaults to "public" if unset. The server's own unit tests set this to
# "test" to run against an isolated copy of the same tables.
# SUPABASE_SCHEMA=public
